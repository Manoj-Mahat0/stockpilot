{
  "name": "stockpilot-backend",
  "version": "1.0.0",
  "description": "StockPilot Express.js API",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "test": "node --test tests/**/*.test.js",
    "vercel-build": "prisma generate"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "stockpilot",
    "express"
  ],
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "bwip-js": "^4.11.4",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "jimp": "^2.1.0",
    "jsbarcode": "^3.12.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pdfkit": "^0.21.0",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8"
  },
  "type": "commonjs",
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
